<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Analytics Dashboard</title>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#0f172a;
  color:white;
  font-family:Arial;
  padding:40px;
}

h1{
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  background:#1e293b;
  padding:25px;
  border-radius:20px;
}

.number{
  font-size:40px;
  margin-top:15px;
  color:#3b82f6;
}

.chart{
  margin-top:20px;
  display:flex;
  align-items:flex-end;
  gap:10px;
  height:150px;
}

.bar{
  width:40px;
  background:#3b82f6;
  border-radius:8px 8px 0 0;
}

</style>
</head>

<body>

<h1>Analytics Dashboard</h1>

<div class="grid">

  <div class="card">
    <h3>Total Users</h3>
    <div class="number">12.4K</div>
  </div>

  <div class="card">
    <h3>Revenue</h3>
    <div class="number">$84K</div>
  </div>

  <div class="card">
    <h3>Performance</h3>

    <div class="chart">

      <div class="bar" style="height:60px"></div>
      <div class="bar" style="height:100px"></div>
      <div class="bar" style="height:140px"></div>
      <div class="bar" style="height:90px"></div>

    </div>

  </div>

</div>

</body>
</html>
